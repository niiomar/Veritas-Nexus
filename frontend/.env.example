# Copy this file to .env and fill in real values. .env is gitignored.

VITE_API_URL=http://localhost:8000

# Must match the backend's PLATFORM_API_KEY (see ../.env.example).
# NOTE: Vite inlines VITE_-prefixed vars into the built client bundle, so this
# is NOT a secret from anyone who opens devtools - it's a stopgap that keeps
# opportunistic/automated traffic off the raw API, not real per-user auth.
VITE_PLATFORM_API_KEY=changeme
