# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - these are live credentials for the ViT-CORE,
# C2PA-Veritas, and ViT-CORE-Audio forensic microservices.

VIT_CORE_API_KEY=changeme
C2PA_API_KEY=changeme
AUDIO_API_KEY=changeme

# Signs/verifies login access tokens and email-verification/password-reset
# links (api/services/auth_service.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every outstanding token and logged-in session.
JWT_SECRET=changeme

# Used to build the links sent in verification/reset emails.
FRONTEND_URL=http://localhost:5173

# No SMTP configured: api/services/email_service.py logs verification/reset
# emails instead of sending them - fine for local dev, not for anyone who
# actually needs to receive the email. Set these to switch to real delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@veritas-nexus.local

# Optional overrides (defaults target the local docker-compose stack):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/veritas_nexus
# VIT_CORE_URL=http://host.docker.internal:8001/api/v1/analyze
# C2PA_URL=http://host.docker.internal:8002/api/v1/verify
# AUDIO_URL=http://host.docker.internal:8003/api/v1/analyze
# EVIDENCE_VAULT_PATH=/app/storage_vault
# Spoof-probability cutoffs for the audio verdict tiers - provisional
# defaults, not yet calibrated against the audio model's real eval set.
# AUDIO_SPOOF_REVIEW_THRESHOLD=0.20
# AUDIO_SPOOF_QUARANTINE_THRESHOLD=0.60
# Comma-separated list of allowed frontend origins. Defaults to local dev
# (http://localhost:5173,http://127.0.0.1:5173) - set explicitly in production.
# CORS_ORIGINS=
