# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - these are live credentials for the ViT-CORE and
# C2PA-Veritas forensic microservices.

VIT_CORE_API_KEY=changeme
C2PA_API_KEY=changeme

# Shared secret the frontend must send as the X-API-Key header on
# state-changing requests (create/update/delete case, upload/delete
# evidence, generate report). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTE: this is a stopgap, not real per-user auth - it's baked into the
# public frontend bundle via VITE_PLATFORM_API_KEY, so it only keeps
# opportunistic/automated traffic off the raw API, not a targeted attacker.
PLATFORM_API_KEY=changeme

# Optional overrides (defaults target the local docker-compose stack):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/veritas_nexus
# VIT_CORE_URL=http://host.docker.internal:8001/api/v1/analyze
# C2PA_URL=http://host.docker.internal:8002/api/v1/verify
